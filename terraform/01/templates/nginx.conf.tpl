# Generated by Terraform. Services: ${join(", ", service_names)}
events {}

http {
  error_log stderr ${log_level};

%{ for name, port in service_ports_map ~}
  upstream ${name} {
    server 127.0.0.1:${port};
  }

%{ endfor ~}
  server {
    listen 80;
    server_name localhost;

%{ for name, port in service_ports_map ~}
%{ if contains(public_services, upper(name)) ~}
    location /${name}/ {
      proxy_pass http://${name}/;
    }

%{ endif ~}
%{ endfor ~}
  }
}
